<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h3>Messages</h3>

        <ul><% messages.forEach(message => { %> <li>
            <strong>Title: </strong> <%= message.title %> |
            <strong>Text: </strong> <%= message.text %> |
            <strong>Date: </strong> <%= message.timestamp %> |
            <strong>Author: </strong> <%= message.username %>
            </li>
    <%    }); %>
    </ul>
    <br>
    <button><a href="/newMessage">+ New Message</a></button>

</body>
</html>